# Variabili d'ambiente di Soveratopoly. Tutte facoltative: il gioco funziona anche senza.
# Il server non legge questo file da solo: impostale nel terminale o nel pannello di Render.

# Porta HTTP. Render la imposta da solo; in locale vale 3000.
PORT=3000

# Indirizzo su cui ascoltare (0.0.0.0 = tutte le interfacce, necessario su Render).
HOST=0.0.0.0

# Altre origini, oltre al sito stesso, da cui si accettano connessioni Socket.IO,
# separate da virgola. Serve solo se il gioco è incorporato in un altro dominio.
# ALLOWED_ORIGINS=https://esempio.it,https://www.esempio.it
