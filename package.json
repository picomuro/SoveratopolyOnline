{
  "name": "soveratopoly",
  "version": "1.0.0",
  "description": "Soveratopoly: gioco da tavolo multiplayer online da browser",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "simulate": "node scripts/simulate.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "socket.io-client": "^4.8.4"
  }
}
